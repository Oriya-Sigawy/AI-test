# Copy to .env and fill in real values. .env holds secrets and is gitignored —
# never commit it. docker compose reads this file for ${...} substitution.

# --- Application secret (required) ---
# HS256 signing key for JWTs. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-generate-a-random-secret

# --- PostgreSQL credentials ---
# Used by the db service and to build the API's in-network DATABASE_URL (compose).
POSTGRES_USER=expense
POSTGRES_PASSWORD=change-me
POSTGRES_DB=expense

# SQLAlchemy URL for running the API outside Docker (uvicorn locally). Inside
# docker compose the API builds its own URL pointing at the `db` service.
DATABASE_URL=postgresql+psycopg://expense:change-me@localhost:5432/expense

# Dedicated database for pytest — never the dev/prod DB. The test database must
# already exist (e.g. `createdb expense_test`); conftest creates the schema in it.
TEST_DATABASE_URL=postgresql+psycopg://expense:change-me@localhost:5432/expense_test

# --- Optional tuning (defaults shown; see app/config.py) ---
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# DEFAULT_PAGE_SIZE=50
# MAX_PAGE_SIZE=100
